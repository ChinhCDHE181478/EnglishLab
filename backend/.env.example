# Application
SPRING_APPLICATION_NAME=backend
SERVER_PORT=8080
APP_SEED_TEST_ENABLED=false
APP_SEED_REVIEW_ENABLED=false
APP_SEED_SHEET_ENABLED=false

# Database
DB_URL=jdbc:postgresql://localhost:5432/englishlab?options=-c%20timezone=Asia/Ho_Chi_Minh
DB_USERNAME=postgres
DB_PASSWORD=
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
# One-time ONLY: existing pre-Flyway non-empty DB with no flyway_schema_history.
# After adoption (history exists), set false. New empty DBs use V1 migrate (do not need true).
FLYWAY_BASELINE_ON_MIGRATE=false

# Authentication
JWT_SECRET=
JWT_EXPIRATION=86400000
GOOGLE_LOGIN_CLIENT_ID=
ENGLISHLAB_AUTH_EMAIL_VERIFICATION_EXPIRATION_MINUTES=15
ENGLISHLAB_AUTH_PASSWORD_RESET_EXPIRATION_MINUTES=15

# Uploads and local storage
MULTIPART_MAX_FILE_SIZE=512MB
MULTIPART_MAX_REQUEST_SIZE=513MB
ENGLISHLAB_AVATARS_DIR=backend/uploads/avatars

# Google Meet
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_MEET_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_MEET_API_BASE_URL=https://meet.googleapis.com/v2
GOOGLE_MEET_REDIRECT_URI=http://localhost:8080/api/teacher/google-meet/callback
GOOGLE_MEET_FRONTEND_RETURN_URL=http://localhost:5173/teacher/professional-profile
GOOGLE_MEET_TOKEN_ENCRYPTION_KEY=
GOOGLE_MEET_RETRY_DELAY_MS=300000
GOOGLE_MEET_RETRY_INITIAL_DELAY_MS=60000
GOOGLE_MEET_AUTO_RECORDING=true
GOOGLE_MEET_RECORDING_AUTO_PUBLISH=false
GOOGLE_MEET_RECORDING_MAX_SYNC_ATTEMPTS=20
GOOGLE_MEET_RECORDING_SYNC_DELAY_MS=60000

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=false
ENGLISHLAB_MAIL_ENABLED=true
ENGLISHLAB_MAIL_FROM=
ENGLISHLAB_MAIL_FROM_NAME=EnglishLab
ENGLISHLAB_WEB_BASE_URL=http://localhost:5173
ENGLISHLAB_CORS_ADDITIONAL_ORIGINS=
ENGLISHLAB_MAIL_LOGO_URL=
ENGLISHLAB_MAIL_HERO_IMAGE_URL=
ENGLISHLAB_SUPPORT_EMAIL=
ENGLISHLAB_SUPPORT_CENTER_URL=http://localhost:5173/support
ENGLISHLAB_PRIVACY_POLICY_URL=http://localhost:5173/privacy

# AI evaluation
ENGLISHLAB_AI_ENABLED=true
ENGLISHLAB_AI_PROVIDER=gemini
ENGLISHLAB_AI_TIMEOUT_SECONDS=60
ENGLISHLAB_AI_TEMPERATURE=0.2

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_INLINE_AUDIO_MAX_BYTES=20971520

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=

# PayOS
ENGLISHLAB_PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
ENGLISHLAB_PAYOS_RETURN_URL=http://localhost:5173/checkout
ENGLISHLAB_PAYOS_CANCEL_URL=http://localhost:5173/checkout
ENGLISHLAB_PAYOS_WEBHOOK_URL=http://localhost:8080/api/payos/webhook
ENGLISHLAB_PAYOS_AUTO_CONFIRM_WEBHOOK=true

