# Copy this file to backend/.env, then fill real values.
# Spring already imports optional file:.env and optional file:backend/.env from application.properties.

# Database
DB_URL=jdbc:postgresql://localhost:5432/englishlab
DB_USERNAME=postgres
DB_PASSWORD=123

# Seed data, turn on only when you want to insert/update seed courses/rubrics.
APP_SEED_ENABLED=false

# Real AI Evaluation
ENGLISHLAB_AI_ENABLED=true
ENGLISHLAB_AI_PROVIDER=gemini
ENGLISHLAB_AI_TIMEOUT_SECONDS=60
ENGLISHLAB_AI_TEMPERATURE=0.2

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Bunny Stream optional
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=

# Lark custom app
LARK_ENABLED=false
LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here
LARK_CALENDAR_ID=
LARK_CALENDAR_NAME=EnglishLab Virtual Training
LARK_TIMEZONE=Asia/Ho_Chi_Minh
LARK_VERIFICATION_TOKEN=
